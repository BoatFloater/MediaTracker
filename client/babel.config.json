{
  "presets": [
    "@babel/preset-env",
    ["@babel/preset-typescript", { "onlyRemoveTypeImports": false }]
  ],
  "overrides": [
    {
      "test": "**/*.tsx",
      "presets": ["@babel/preset-react"]
    }
  ],
  "plugins": [
    [
      "polyfill-corejs3",
      {
        "method": "usage-global",
        "version": "3.51.0"
      }
    ],
    "@babel/plugin-transform-runtime",
    "@lingui/babel-plugin-lingui-macro"
  ]
}
